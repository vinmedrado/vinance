# VinanceOS production template. Never commit real values.
ENVIRONMENT=production
APP_NAME=VinanceOS
APP_VERSION=2.0.0
APP_COMMIT_SHA=replace-with-git-sha
DEBUG=false
LOG_LEVEL=INFO
API_DOCS_ENABLED=false
REGISTRATION_ENABLED=false
RATE_LIMITING_ENABLED=true
AUTH_RATE_LIMIT_WINDOW_SECONDS=60
LOGIN_RATE_LIMIT=10
LOGIN_IP_RATE_LIMIT=50
REGISTER_RATE_LIMIT=5
REFRESH_RATE_LIMIT=30
PASSWORD_CHANGE_RATE_LIMIT=5
INVITATION_RATE_LIMIT=20
CONTINUOUS_EVALUATE_RATE_LIMIT=6

# Same-origin public contract. Phase F replaces this placeholder with HTTPS.
CORS_ORIGINS=https://vinance.example.invalid
TRUSTED_HOSTS=vinance.example.invalid
# Safe only because backend:8000 is private and Nginx overwrites forwarded headers.
FORWARDED_ALLOW_IPS=*
EDGE_PORT=8080

POSTGRES_DB=vinance
POSTGRES_USER=vinance_app
POSTGRES_PASSWORD=replace-with-a-strong-random-password
# URL-encode reserved characters in credentials.
DATABASE_URL=postgresql+asyncpg://vinance_app:replace-with-url-encoded-password@postgres:5432/vinance

REDIS_PASSWORD=replace-with-a-strong-random-password
REDIS_URL=redis://:replace-with-url-encoded-password@redis:6379/0
CELERY_BROKER_URL=redis://:replace-with-url-encoded-password@redis:6379/1
CELERY_RESULT_BACKEND=redis://:replace-with-url-encoded-password@redis:6379/2
CELERY_TIMEZONE=America/Sao_Paulo

# Generate with a cryptographically secure source (at least 32 random bytes).
SECRET_KEY=replace-with-a-strong-random-secret-at-least-32-bytes
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30

WEB_CONCURRENCY=2
WEB_TIMEOUT_SECONDS=120
WEB_GRACEFUL_TIMEOUT_SECONDS=30
CELERY_WORKER_CONCURRENCY=2
DOCKER_LOG_MAX_SIZE=10m
DOCKER_LOG_MAX_FILES=5

DEMO_MODE_ENABLED=false
ANALYTICS_ENABLED=false
VITE_ANALYTICS_ENABLED=false
# Public browser ingestion identifier; this is not a server secret.
VITE_POSTHOG_PROJECT_ID=
VITE_POSTHOG_HOST=https://app.posthog.com
VITE_SENTRY_DSN=

GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Mount the actual passphrase as a protected file. Do not place it in this env.
BACKUP_PASSPHRASE_FILE=/run/secrets/backup_passphrase
BACKUP_PASSPHRASE_FILE_HOST=/opt/vinanceos/secrets/backup-passphrase
BACKUP_DATABASE_URL=postgresql://vinance_app:replace-with-url-encoded-password@postgres:5432/vinance
BACKUP_DAILY_KEEP=7
BACKUP_WEEKLY_KEEP=4
BACKUP_MONTHLY_KEEP=3
