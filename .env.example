# Vinance v2 — exemplo seguro de ambiente local
# Copie para .env e ajuste os valores. Nunca versionar .env real.

# Runtime
ENVIRONMENT=development
APP_NAME=Vinance v2
APP_VERSION=2.0.0
DEBUG=false
LOG_LEVEL=INFO
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:9000

# Database / Postgres
POSTGRES_DB=vinance
POSTGRES_USER=vinance
POSTGRES_PASSWORD=vinance-local-only
DATABASE_URL=postgresql+asyncpg://vinance:vinance-local-only@postgres:5432/vinance

# Redis / Celery
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1
CELERY_TIMEZONE=America/Sao_Paulo

# Security
# Em produção, gere uma chave aleatória forte com 32+ caracteres.
# Placeholders em inglês ou português são bloqueados quando ENVIRONMENT=production.
SECRET_KEY=troque-por-uma-chave-segura-com-mais-de-32-caracteres
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Advisor IA / Groq
# Opcional em desenvolvimento. Não versionar chave real.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Frontend local
VITE_API_BASE_URL=http://localhost:8000
VITE_API_PREFIX=/api/v1
