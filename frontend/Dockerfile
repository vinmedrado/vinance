FROM node:20-bookworm-slim AS build
WORKDIR /app

ARG VITE_API_BASE_URL=
ARG VITE_API_PREFIX=/api/v1
ARG VITE_REGISTRATION_ENABLED=false
ARG VITE_ANALYTICS_ENABLED=false
ARG VITE_POSTHOG_PROJECT_ID=
ARG VITE_POSTHOG_HOST=https://app.posthog.com
ARG VITE_SENTRY_DSN=
ARG VITE_SENTRY_TRACES_SAMPLE_RATE=0.05

ENV VITE_API_BASE_URL=$VITE_API_BASE_URL \
    VITE_API_PREFIX=$VITE_API_PREFIX \
    VITE_REGISTRATION_ENABLED=$VITE_REGISTRATION_ENABLED \
    VITE_ANALYTICS_ENABLED=$VITE_ANALYTICS_ENABLED \
    VITE_POSTHOG_PROJECT_ID=$VITE_POSTHOG_PROJECT_ID \
    VITE_POSTHOG_HOST=$VITE_POSTHOG_HOST \
    VITE_SENTRY_DSN=$VITE_SENTRY_DSN \
    VITE_SENTRY_TRACES_SAMPLE_RATE=$VITE_SENTRY_TRACES_SAMPLE_RATE

COPY package.json package-lock.json ./

RUN npm ci --legacy-peer-deps --include=dev

COPY . .
RUN npm run build

FROM nginxinc/nginx-unprivileged:1.27-alpine
COPY nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/dist /usr/share/nginx/html
EXPOSE 8080
CMD ["nginx", "-g", "daemon off;"]
